# ======== Planificación Delaire 2000 — configuración del SERVIDOR ========
# Copia este fichero como .env y rellénalo. El .env nunca se sube al repositorio
# ni se envía al navegador.

PORT=3000
TZ_CALENDARIO=Europe/Madrid
# Carpeta donde se guarda la base de datos de asignaciones (SQLite). Haz copia de seguridad.
DATA_DIR=./data

# --- Acceso a la aplicación ---
# Contraseña de planificación (editar). Mínimo 10 caracteres.
APP_PASSWORD=
# Opcional: contraseña de solo visualización (pantalla/TV).
DISPLAY_PASSWORD=
# Opcional: enlace sin contraseña para la TV -> https://tu-dominio/pantalla?k=DISPLAY_TOKEN (mín. 24 caracteres)
DISPLAY_TOKEN=
# Secreto aleatorio largo (mín. 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# true si la app se sirve por HTTPS (recomendado en producción)
COOKIE_SECURE=false
# Si está detrás de un proxy inverso (nginx, Caddy...), pon true
TRUST_PROXY=
# URL pública (necesaria para la conexión OAuth de Google), p. ej. https://planificacion.delaire-2000.com
PUBLIC_URL=

# --- Calendario (SOLO LECTURA) ---
# google | microsoft | demo   (demo = eventos ficticios para probar; nunca en producción)
CALENDAR_PROVIDER=google
SYNC_INTERVAL_SECONDS=60

# Google — opción A (recomendada): cuenta de servicio con el calendario compartido
# en modo «Ver todos los detalles de los eventos».
GOOGLE_CALENDAR_ID=info@delaire-2000.com
GOOGLE_SERVICE_ACCOUNT_FILE=
# Solo si usas delegación de dominio de Google Workspace (en vez de compartir el calendario):
GOOGLE_IMPERSONATE_USER=

# Google — opción B: OAuth iniciando sesión una vez con info@delaire-2000.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_LOGIN_HINT=info@delaire-2000.com

# Microsoft 365 / Outlook (si el calendario info@ está en Microsoft 365)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_CALENDAR_USER=info@delaire-2000.com
